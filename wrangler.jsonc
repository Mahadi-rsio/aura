{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aura",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787,
    "local_protocol": "http",
  },
}
