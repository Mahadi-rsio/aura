DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/aura?sslmode=require
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
# S3-compatible object storage. Locally this is MinIO; on Cloudflare use the
# R2 S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (region=auto).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=auraadmin
MINIO_SECRET_ACCESS_KEY=aura-secret-key
MINIO_BUCKET=aura
MINIO_REGION=us-east-1
# Optional. Defaults to path-style for MinIO/AWS S3 and virtual-hosted style
# for Cloudflare R2. Set to true/false to override.
MINIO_FORCE_PATH_STYLE=
